# Optional: Gemini API key for headless agy authentication inside the container
GEMINI_API_KEY=
TZ=Asia/Kathmandu

# 127.0.0.1 = localhost only; 0.0.0.0 = whole LAN
BIND_IP=127.0.0.1
PORT=4567

# Resource caps for rendering
MEM_LIMIT=8g
CPUS=4

# --- SSH (for n8n) ---
# Root password for SSH login. REQUIRED. Use a long random value:
#   openssl rand -base64 24
ROOT_PASSWORD=
# Host port for testing SSH from this machine (bound to BIND_IP)
SSH_PORT=2222
# Existing Docker network that n8n is on (Coolify's default is "coolify")
N8N_NETWORK=coolify
